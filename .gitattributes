Dockerfile* linguist-language=Dockerfile

*.c    diff=cpp
*.h    diff=cpp
*.go   diff=golang
*.md   diff=markdown
*.py   diff=python
*.sh   diff=bash

# Protobuf bindings and extension schemas/wiring.
/**/*.pb.go linguist-generated=true
/extpoints/**/*.proto linguist-generated=true
/extpoints/**/protogen/** linguist-generated=true
