    label:  LABEL_OPTIONAL
    type:  TYPE_STRING
    json_name:  "point"
  }
  field:  {
    name:  "extension"
    number:  2
    label:  LABEL_OPTIONAL
    type:  TYPE_STRING
    json_name:  "extension"
  }
  field:  {
    name:  "optional"
    number:  3
    label:  LABEL_OPTIONAL
    type:  TYPE_BOOL
    json_name:  "optional"
  }
}
message_type:  {
